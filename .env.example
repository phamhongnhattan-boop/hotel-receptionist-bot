# Copy this file to .env and fill in. NEVER commit .env to GitHub.

# Option A: API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B: Vertex AI (set USE_VERTEX=true and run: gcloud auth application-default login)
USE_VERTEX=false
GCP_PROJECT=
GCP_LOCATION=asia-southeast1

GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
EMBED_MODEL=gemini-embedding-001

# Security limits (defaults are fine for the demo)
RATE_LIMIT_PER_MINUTE=10
DAILY_MESSAGE_LIMIT=500
PROXY_HOPS=1
MAX_SESSIONS=500
SESSION_TTL_MINUTES=30
MAX_BOOKINGS_PER_SESSION=2
ENABLE_DOCS=false
